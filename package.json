{
  "name": "@involvex/ctrl",
  "version": "0.0.1",
  "private": true,
  "description": "involvex/ctrl monorepo — local agent platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun check",
    "format": "bun fmt --check",
    "format:write": "bun fmt",
    "validate": "bun check && bun lint && bun fmt --check",
    "dev:gateway": "bun run ./packages/ctrl-a/src/server.ts",
    "gateway:free": "bun run scripts/free-gateway-port.ts",
    "dev:desktop": "bun run --filter @involvex/ctrl-desktop dev",
    "dev:cli": "bun run --filter @involvex/ctrl-f5 start",
    "build": "bun run build:packages && bun run build:apps",
    "build:packages": "bun run --filter @involvex/ctrl-s build && bun run --filter @involvex/ctrl-z build && bun run --filter @involvex/ctrl-k build && bun run --filter @involvex/ctrl-c build && bun run --filter @involvex/ctrl-r build && bun run --filter @involvex/ctrl-x build && bun run --filter @involvex/ctrl-m build && bun run --filter @involvex/ctrl-i build && bun run --filter @involvex/ctrl-a build && bun run --filter @involvex/ctrl-t build",
    "build:ctrl-c": "bun run --filter @involvex/ctrl-c build",
    "build:ctrl-k": "bun run --filter @involvex/ctrl-k build",
    "build:ctrl-r": "bun run --filter @involvex/ctrl-r build",
    "build:ctrl-x": "bun run --filter @involvex/ctrl-x build",
    "build:ctrl-m": "bun run --filter @involvex/ctrl-m build",
    "build:apps": "bun run --filter @involvex/ctrl-f5 build && bun run --filter @involvex/ctrl-desktop build && bun run --filter @involvex/ctrl-mobile build && bun run --filter @involvex/ctrl-web build",
    "build:ctrl-s": "bun run --filter @involvex/ctrl-s build",
    "build:ctrl-z": "bun run --filter @involvex/ctrl-z build",
    "build:ctrl-i": "bun run --filter @involvex/ctrl-i build",
    "build:ctrl-a": "bun run --filter @involvex/ctrl-a build",
    "build:ctrl-t": "bun run --filter @involvex/ctrl-t build",
    "build:cli": "bun run --filter @involvex/ctrl-f5 build",
    "build:desktop": "bun run --filter @involvex/ctrl-desktop package",
    "build:desktop:dir": "bun run --filter @involvex/ctrl-desktop package:dir",
    "build:desktop:vite": "bun run --filter @involvex/ctrl-desktop build",
    "build:mobile": "bun run --filter @involvex/ctrl-mobile build",
    "build:web": "bun run --filter @involvex/ctrl-web build",
    "test": "bun test",
    "test:contracts": "bun run --filter @involvex/ctrl-t test:live",
    "docs:dev": "bunx --bun vitepress dev docs",
    "docs:build": "bunx --bun vitepress build docs",
    "docs:preview": "bunx --bun vitepress preview docs"
  },
  "engines": {
    "bun": ">=1.3.4"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "tar": "7.5.22",
    "postcss": "8.5.30",
    "uuid": "11.1.1",
    "builder-util-runtime": "9.7.0",
    "image-size": "2.0.4",
    "esbuild": "0.25.12",
    "vite": "6.4.4",
    "app-builder-lib": "26.15.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/server-renderer": "^3.5.44",
    "sharp": "^0.35.5",
    "vitepress": "^1.6.3",
    "vue": "^3.5.44"
  }
}
