{
  "name": "@involvex/ctrl",
  "version": "0.0.1",
  "private": true,
  "description": "involvex/ctrl monorepo — local agent platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun check",
    "lint": "bun lint",
    "format": "bun fmt --check",
    "format:write": "bun fmt",
    "validate": "bun check && bun lint && bun fmt --check",
    "dev:gateway": "bun run --filter @involvex/ctrl-a dev",
    "dev:desktop": "bun run --filter @involvex/ctrl-desktop dev",
    "dev:cli": "bun run --filter @involvex/ctrl-f5 start",
    "build": "bun run build:packages && bun run build:apps",
    "build:packages": "bun run --filter @involvex/ctrl-s build && bun run --filter @involvex/ctrl-a build",
    "build:apps": "bun run --filter @involvex/ctrl-f5 build && bun run --filter @involvex/ctrl-desktop build && bun run --filter @involvex/ctrl-mobile build && bun run --filter @involvex/ctrl-web build",
    "build:ctrl-s": "bun run --filter @involvex/ctrl-s build",
    "build:ctrl-a": "bun run --filter @involvex/ctrl-a build",
    "build:cli": "bun run --filter @involvex/ctrl-f5 build",
    "build:desktop": "bun run --filter @involvex/ctrl-desktop build",
    "build:mobile": "bun run --filter @involvex/ctrl-mobile build",
    "build:web": "bun run --filter @involvex/ctrl-web build",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.3.4"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5"
  }
}
