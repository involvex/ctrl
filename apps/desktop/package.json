{
  "name": "@involvex/ctrl-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Electron desktop shell for @involvex/ctrl",
  "author": "involvex",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gateway": "bun run scripts/build-gateway.ts",
    "package": "bun run build && bun run build:gateway && electron-builder --config electron-builder.yml --win --x64",
    "package:dir": "bun run build && bun run build:gateway && electron-builder --config electron-builder.yml --win dir --x64",
    "check": "bun check",
    "start": "vite"
  },
  "dependencies": {
    "@involvex/ctrl-i": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
