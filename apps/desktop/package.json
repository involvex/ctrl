{
  "name": "@involvex/ctrl-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Electron desktop shell for @involvex/ctrl",
  "author": "involvex",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gateway": "bun run scripts/build-gateway.ts",
    "package": "bun run build && bun run build:gateway && electron-builder --config electron-builder.yml --win --x64",
    "package:dir": "bun run build && bun run build:gateway && electron-builder --config electron-builder.yml --win dir --x64",
    "check": "bun check",
    "start": "vite"
  },
  "dependencies": {
    "@involvex/ctrl-i": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
