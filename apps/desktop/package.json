{
  "name": "@involvex/ctrl-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Electron desktop shell for @involvex/ctrl",
  "author": "involvex",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gateway": "bun run scripts/build-gateway.ts",
    "package": "bun run build && bun run build:gateway && bun run package:electron -- --win --x64",
    "package:dir": "bun run build && bun run build:gateway && bun run package:electron -- --win dir --x64",
    "package:electron": "node ./node_modules/electron-builder/cli.js --config electron-builder.yml",
    "check": "bun check",
    "start": "vite"
  },
  "dependencies": {
    "@involvex/ctrl-i": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
