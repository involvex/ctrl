{
  "name": "@involvex/ctrl-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Electron desktop shell for @involvex/ctrl",
  "author": "involvex",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gateway": "bun run scripts/build-gateway.ts",
    "package": "bun run build && bun run build:gateway && bun run package:electron -- --win --x64",
    "package:dir": "bun run build && bun run build:gateway && bun run package:electron -- --win dir --x64",
    "package:electron": "node ./node_modules/electron-builder/cli.js --config electron-builder.yml",
    "check": "bun check",
    "start": "vite"
  },
  "dependencies": {
    "@involvex/ctrl-i": "workspace:*",
    "@involvex/ctrl-s": "workspace:*",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
