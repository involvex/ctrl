{
  "name": "@involvex/ctrl-a",
  "version": "0.0.1",
  "private": true,
  "description": "Gateway daemon — Agent & All",
  "type": "module",
  "bin": {
    "ctrl-a": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/server.ts",
    "start": "bun run src/server.ts",
    "check": "bun check",
    "build": "bun build ./src/server.ts ./src/cli.ts --outdir ./dist --target=bun --sourcemap=external",
    "build:compile": "bun run ../../apps/desktop/scripts/build-gateway.ts"
  },
  "dependencies": {
    "@involvex/ctrl-k": "workspace:*",
    "@involvex/ctrl-m": "workspace:*",
    "@involvex/ctrl-r": "workspace:*",
    "@involvex/ctrl-s": "workspace:*",
    "@involvex/ctrl-x": "workspace:*",
    "@involvex/ctrl-z": "workspace:*"
  }
}
